# Secrets — never commit. Only .env.example belongs in git.
.env
.env.*
!.env.example

# NOTE: research/harness/recorded/ is deliberately NOT ignored. Those payloads
# were paid for in credits; committing them is what stops a second teammate paying
# for the same call. They contain no key — capture.py never writes credentials.

# The portal usage-log exports in research/evidence/usage-log/ ARE committed: they are the
# only independent record of what the API actually charged, and they contain no credentials
# — endpoint, status and credit count only.

# Python / Node
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
node_modules/

# Logs and local scratch
*.log
.scratch/

# Editor / OS
.DS_Store
.idea/
.vscode/
.firecrawl/

# Scoring output, not paid data: firewall.py appends a line per run and it regenerates
# from local payloads every time. The credit ledger it sits next to IS committed —
# that one records money spent, this one records opinions formed.
src/*/warnings.jsonl
