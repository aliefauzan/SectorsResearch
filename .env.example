# Sectors hackathon — shared configuration template.
#
# Copy this file to `.env` at the repository root and fill in the key:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit it, never paste the key into a doc, a
# screenshot, an issue, or a chat message. Anything in the real environment wins
# over this file, so CI and one-off overrides still work:
#
#     SECTORS_BUDGET=5 python3 research/03-mock-data/capture.py --plan ... --tier 0

# --- required for any live call -------------------------------------------------
# The team's Sectors API key, claimed from the hackathon portal team page.
# Sent as the raw Authorization header value (no "Bearer " prefix for the REST API).
SECTORS_API_KEY=

# --- optional -------------------------------------------------------------------
# Point the capture harness at the local mock instead of the live API. Rehearse
# every run against the mock first; a rehearsal costs nothing.
#   SECTORS_BASE_URL=http://127.0.0.1:8787
SECTORS_BASE_URL=https://api.sectors.app

# Hard credit ceiling for capture.py when --budget is not passed. The grant is
# 1,000 credits total and does not top up. Keep this low; raise it deliberately.
SECTORS_BUDGET=250

# --- pengiriman (tugas 19) ------------------------------------------------------
# Telegram bot credentials for the daily tick's transition alerts. Costs no Sectors
# credits — Telegram is not the Sectors API. Left empty, the tick still screens and
# still writes its line to state/runs.jsonl; it only records that delivery was not
# configured. Get the token from @BotFather, and the chat id by adding the bot to
# the channel and reading getUpdates. Never commit either value; in GitHub Actions
# they are repository secrets, not file contents.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
